T[t] = updatePathWeight([path], WT[t], RD[i])\n","            SCHD[t].append((RDN[i],RD[i]))\n","            RD[i] = 0\n","            DServed += 1\n","            breakFlag=True\n","            break\n","          else:\n","            t += 1\n","        if breakFlag:\n","          break\n","    #print(f'Naive:------ Demand: {( RDN[i][0], RDN[i][1])} and available no. of paths: {len(RX)}, unuseful no. of paths: {len(RX)-path_counter}')\n","  #print(f'EPRServed: {EPRServed}, DServed: {DServed}')\n","  return EPRServed, SCHD, DServed"]},{"cell_type":"markdown","metadata":{"id":"Z2HAgyyClzrY"},"source":["**Increase No of EPRs**"]},{"cell_type":"code","execution_count":82,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lX8ntzpwlncP","executionInfo":{"status":"ok","timestamp":1762339187844,"user_tz":-330,"elapsed":2894,"user":{"displayName":"Anoop Kumar Pandey","userId":"13563856173008158940"}},"outputId":"62e3547d-e327-4d30-f23b-92e3f91a96d4"},"outputs":[{"output_type":"stream","name":"stdout","text":["iteration: 0\n","1\n","11\n","21\n","31\n","41\n","51\n","61\n","71\n","81\n","91\n"]}],"source":["k=50\n","\n","max_demand_size = 100\n","lowerBound = 1\n","step = 10\n","# iteration = upperBound - lowerBound\n","iterations = 1\n","\n","#To ensure probabilistic nature, we need to repeat each 'number_of_demands' multiple times and average out for each 'number_of_demands'\n","average_eprres1 = [0 for i in range(lowerBound, max_demand_size, step)]\n","average_eprres2 = [0 for i in range(lowerBound, max_demand_size, step)]\n","average_eprres5 = [0 for i in range(lowerBound, max_demand_size, step)]\n","average_dres5 = [0 for i in range(lowerBound, max_demand_size, step)]\n","average_dres1 = [0 for i in range(lowerBound, max_demand_size, step)]\n","average_dres2 = [0 for i in range(lowerBound, max_demand_size, step)]\n","\n","\n","\n","for iteration in range(iterations):\n","\n","  print(f'iteration: {iteration}')\n","  eprres1 = []\n","  eprres2 = []\n","  e