append(i)\n","\n","allowedWeightValues = list(range(1,5))  #allowedWeightValues = [1, 2, 3, 4, 5]\n","noOfEdges = len(E)\n","g = ig.Graph(v, E)\n","F = [random.uniform(0.9, 1.0) for _ in range(len(E))]\n","\n","\n","nx.draw_networkx(G)\n","\"\"\"\n","fig, ax = plt.subplots()\n","ig.plot(\n","    g,\n","    target=ax,\n","    layout='circle',\n","    vertex_color='steelblue',\n","    vertex_label=range(g.vcount()),\n","    edge_width=1,\n","    edge_color='#666',\n","    edge_align_label=True,\n","    edge_background='white'\n",")\n","\"\"\""]},{"cell_type":"code","execution_count":57,"metadata":{"executionInfo":{"elapsed":8,"status":"ok","timestamp":1762332597324,"user":{"displayName":"Anoop Kumar Pandey","userId":"13563856173008158940"},"user_tz":-330},"id":"V5yuG2UN6h8x"},"outputs":[],"source":["def end_to_end_fidelity(path):\n","    \"\"\"\n","    Compute end-to-end fidelity recursively for a given path.\n","    Uses global edge list E and fidelity list F.\n","    Rule: f = f1*f2 + (1/3)*(1-f1)*(1-f2)\n","    \"\"\"\n","    def combine(f1, f2):\n","        return f1 * f2 + (1/3) * (1 - f1) * (1 - f2)\n","\n","    # Base case: if only one edge, just return its fidelity\n","    if len(path) == 2:\n","        u, v = path\n","        if (u, v) in E:\n","            return F[E.index((u, v))]\n","        elif (v, u) in E:\n","            return F[E.index((v, u))]\n","        else:\n","            raise ValueError(f\"Edge ({u},{v}) not found in E\")\n","\n","    # Step 1: compute fidelities for all adjacent pairs\n","    combined = []\n","    i = 0\n","    while i < len(path) - 1:\n","        # if at least two edges ahead, combine pairwise\n","        if i + 2 < len(path):\n","            f1 = end_to_end_fidelity(path[i:i+2])\n","            f2 = end_to_end_fidelity(path[i+1:i+3])\n","            combined_f = combine(f1, f2)\n","            combined.append(combined_f)\n","            i += 2  # skip to next pair\n","        else:\n","            # leftover single edge\n","            combined.append(end_to_end_fidelity(path[i:i+2]))\n","            break\n","\n","    # If only one combined value remains, that's the end-to-end fidelity\n","    if len(combined) == 1:\n","        return combined[0]\n","    else:\n","        # Otherwise, recursively combine again\n","        return end_to_end_fidelity_from_values(combined, combine)\n","\n","\n","def end_to_end_fidelity_from_values(values, combine):\n","    \"\"\"Helper to recursively combine a list of fidelity values.\"\"\"\n","    if len(values) == 1:\n","        return values[0]\n","\n","    new_values = []\n","    i = 0\n","    while i < len(values):\n","        if i + 1 < len(values):\n","            new_values.append(combine(values[i], values[i + 1]))\n","            i += 2\n","        else:\n","            new_values.append(values[i])\n","            break\n","\n","    return end_to_end_fidelity_from_values(new_values, combine)"]},{"cell_type":"code","execution_count":45,"metadata":{"executionInfo":{"elapsed":45,"status":"ok","timestamp":1762332493096,"user":{"displayName":"Anoop Kumar Pandey","userId":"13563856173008158940"},"user_tz":-330},"id":"d2FBREWn0wJA"},"outputs":[],"source":["def findSEPR(path, WT):\n","  sEPR = max(WT)\n","  for i in range(len(path[0])-1):\n","    if (path[0][i],path[0][i+1]) in E:\n","      index = E.index((path[0][i],path[0][i+1]))\n","    else:\n","      index = E.index((path[0][i+1],path[0][i]))\n","    if sEPR >= WT[index]:\n","      sEPR = WT[index]\n","  return sEPR\n","def updatePathWeight(path, pathWeight, updateFactor):\n","  for i in range(len(path[0])-1):\n","    if (path[0][i],path[0][i+1]) in E:\n","      index = E.index((path[0][i],path[0][i+1]))\n","    else:\n","      index = E.index((path[0][i+1],path[0][i]))\n","    pathWeight[index] = pathWeight[index] - updateFactor\n","  return pathWeight"]},{"cell_type":"code","execution_count":46,"metadata":{"executionInfo":{"elapsed":15,"status":"ok","timestamp":1762332495556,"user":{"displayNa